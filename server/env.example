# Copia este archivo a server/.env y rellena los valores (no subas .env al repositorio).

PORT=3847

# Orígenes del front Angular (coma si hay varios). Producción: https://tudominio.com
CORS_ORIGIN=http://localhost:4200

# Buzón que recibe las cotizaciones y remitente SMTP (suele ser el mismo usuario SMTP)
MAIL_TO=cotizaciones@tudominio.com
MAIL_FROM=cotizaciones@tudominio.com

# Opcional: si defines una clave, el cliente debe enviarla en el header x-quote-api-key
# (misma clave en cotiza-email.config.ts → COTIZA_QUOTE_API_KEY)
# MAIL_API_KEY=

# Ejemplo Brevo (gratis): smtp-relay.brevo.com, puerto 587, usuario = login Brevo, pass = SMTP key
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Gmail: smtp.gmail.com, puerto 587, usuario = tu@gmail.com, pass = "contraseña de aplicación"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@gmail.com
# SMTP_PASS=xxxx
